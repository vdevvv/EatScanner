{
  "expo": {
    "name": "Taal Eat",
    "slug": "taal-eat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.r1020304050.EatScanner"
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "READ_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#9F0B08",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.r1020304050.EatScanner",
      "googleServicesFile": "./google-services.json"
    },
    "web": {},
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      "expo-video",
      [
        "expo-contacts",
        {
          "contactsPermission": "The app needs access to your contacts so you can find friends"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "947c44db-dbbe-46b2-9966-1e3b72d9996b"
      }
    },
    "owner": "r1020304050"
  }
}
